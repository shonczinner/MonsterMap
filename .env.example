# MonsterMap build configuration.
# Copy this file to `.env` and adjust the paths to match your checkout.
# Paths may reference ${ENGINE_DIR} / ${CONTENT_DIR} / ${CLIENT_DIR}; those are
# expanded from the base dirs below (define the base dirs first).

# --- base dirs (defaults shown) ---
ENGINE_DIR=../Server/engine
CONTENT_DIR=../Server/content
CLIENT_DIR=../Server/webclient

# --- required inputs (defaults derived from the base dirs) ---
MAPS_SERVER_ZIP=${ENGINE_DIR}/data/pack/.cache/maps-server.zip
WORLDMAP_JAG=${ENGINE_DIR}/data/pack/mapview/worldmap.jag
DROP_SCRIPTS_DIR=${CONTENT_DIR}/scripts

# --- optional output locations (default under ./out) ---
OUT_DIR=out
# MAPS_DIR=${OUT_DIR}/maps
# DATA_DIR=${OUT_DIR}/data
# BUILD_DIR=${OUT_DIR}/build
